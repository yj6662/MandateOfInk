  m_Name: "HP_1_\uC81C\uC790\uD574 \uC124\uC74C(\u820C\u97F3)"
  m_EditorClassIdentifier: MandateOfInk.Data::MandateOfInk.Data.HaeryePageSO
  SortOrder: 1
  Title: "\uC81C\uC790\uD574 \uC124\uC74C(\u820C\u97F3)"
  SourceBook: "\u8A13\u6C11\u6B63\u97F3 \u89E3\u4F8B\u672C"
  RelatedElement: 1
  HanjaQuote: "\u820C\u97F3\u3134 \u8C61\u820C\u9644\u4E0A\u816D\u4E4B\u5F62 \u2026
    \u820C\u92B3\u800C\u52D5 \u706B\u4E5F"
  KoreanText: "\uD613\uC18C\uB9AC \u3134\uC740 \uD600\uAC00 \uC717\uC787\uBAB8\uC5D0
    \uBD99\uB294 \uBAA8\uC591\uC744 \uBCF8\uB5B4\uB2E4. \uD600\uB294 \uB0A0\uCE74\uB86D\uACE0
    \uC798 \uC6C0\uC9C1\uC5EC \uBD88\uACFC \uAC19\uC73C\uB2C8, \uADF8 \uC18C\uB9AC\uB294
    \uD654(\u706B)\uC5D0 \uC18D\uD55C\uB2E4. \uBD88\uC774 \uAD6C\uB974\uBA70 \uBC88\uC9C0\uB4EF
    \uD600\uB05D\uC758 \uC18C\uB9AC\uB3C4 \uAD6C\uB978\uB2E4."
  Lore: "\u3134\xB7\u3137\xB7\u314C\xB7\u3139\uC758 \uC9C4\uC774 \uBD88\uAF43\uC73C\uB85C
    \uD53C\uC5B4\uB098\uB294 \uC774\uCE58\uAC00 \uC5EC\uAE30 \uC788\uB2E4."
