  m_Name: "HP_3_\uC81C\uC790\uD574 \uCE58\uC74C(\u9F52\u97F3)"
  m_EditorClassIdentifier: MandateOfInk.Data::MandateOfInk.Data.HaeryePageSO
  SortOrder: 3
  Title: "\uC81C\uC790\uD574 \uCE58\uC74C(\u9F52\u97F3)"
  SourceBook: "\u8A13\u6C11\u6B63\u97F3 \u89E3\u4F8B\u672C"
  RelatedElement: 3
  HanjaQuote: "\u9F52\u97F3\u3145 \u8C61\u9F52\u5F62 \u2026 \u9F52\u525B\u800C\u65B7
    \u91D1\u4E5F"
  KoreanText: "\uC787\uC18C\uB9AC \u3145\uC740 \uC774\uC758 \uBAA8\uC591\uC744 \uBCF8\uB5B4\uB2E4.
    \uC774\uB294 \uB2E8\uB2E8\uD558\uACE0 \uB04A\uC5B4 \uB0B4\uB2C8 \uC1E0\uC640
    \uAC19\uC544, \uADF8 \uC18C\uB9AC\uB294 \uAE08(\u91D1)\uC5D0 \uC18D\uD55C\uB2E4.
    \uC1E0\uAC00 \uB0A0\uC744 \uC138\uC6CC \uBCA0\uB4EF \uC787\uC18C\uB9AC\uB294
    \uB04A\uC5B4 \uB0B8\uB2E4."
  Lore: "\u3145\xB7\u3148\xB7\u314A\uC758 \uC9C4\uC774 \uC1F3\uB0A0\uB85C \uC11C\uB294
    \uC774\uCE58\uAC00 \uC5EC\uAE30 \uC788\uB2E4."
