  m_Name: "HP_4_\uC81C\uC790\uD574 \uD6C4\uC74C(\u5589\u97F3)"
  m_EditorClassIdentifier: MandateOfInk.Data::MandateOfInk.Data.HaeryePageSO
  SortOrder: 4
  Title: "\uC81C\uC790\uD574 \uD6C4\uC74C(\u5589\u97F3)"
  SourceBook: "\u8A13\u6C11\u6B63\u97F3 \u89E3\u4F8B\u672C"
  RelatedElement: 4
  HanjaQuote: "\u5589\u97F3\u3147 \u8C61\u5589\u5F62 \u2026 \u5589\u9083\u800C\u6F64
    \u6C34\u4E5F"
  KoreanText: "\uBAA9\uAD6C\uBA4D\uC18C\uB9AC \u3147\uC740 \uBAA9\uAD6C\uBA4D\uC758
    \uBAA8\uC591\uC744 \uBCF8\uB5B4\uB2E4. \uBAA9\uAD6C\uBA4D\uC740 \uAE4A\uACE0
    \uC816\uC5B4 \uC788\uC5B4 \uBB3C\uACFC \uAC19\uC73C\uB2C8, \uADF8 \uC18C\uB9AC\uB294
    \uC218(\u6C34)\uC5D0 \uC18D\uD55C\uB2E4. \uBB3C\uC774 \uAE4A\uC740 \uB370\uC11C
    \uD758\uB7EC\uB098\uC624\uB4EF \uC18C\uB9AC\uB3C4 \uAE4A\uC740 \uB370\uC11C \uB09C\uB2E4."
  Lore: "\u3147\xB7\u314E\uC758 \uC9C4\uC774 \uBB3C\uAE38\uB85C \uD750\uB974\uB294
    \uC774\uCE58\uAC00 \uC5EC\uAE30 \uC788\uB2E4."
