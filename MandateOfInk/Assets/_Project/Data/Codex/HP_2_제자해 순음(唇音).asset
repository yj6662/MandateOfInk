  m_Name: "HP_2_\uC81C\uC790\uD574 \uC21C\uC74C(\u5507\u97F3)"
  m_EditorClassIdentifier: MandateOfInk.Data::MandateOfInk.Data.HaeryePageSO
  SortOrder: 2
  Title: "\uC81C\uC790\uD574 \uC21C\uC74C(\u5507\u97F3)"
  SourceBook: "\u8A13\u6C11\u6B63\u97F3 \u89E3\u4F8B\u672C"
  RelatedElement: 2
  HanjaQuote: "\u5507\u97F3\u3141 \u8C61\u53E3\u5F62 \u2026 \u5507\u65B9\u800C\u5408
    \u571F\u4E5F"
  KoreanText: "\uC785\uC220\uC18C\uB9AC \u3141\uC740 \uC785\uC758 \uBAA8\uC591\uC744
    \uBCF8\uB5B4\uB2E4. \uC785\uC220\uC740 \uBAA8\uB098\uACE0 \uB2E4\uBB3C\uC5B4\uC838
    \uB545\uACFC \uAC19\uC73C\uB2C8, \uADF8 \uC18C\uB9AC\uB294 \uD1A0(\u571F)\uC5D0
    \uC18D\uD55C\uB2E4. \uB545\uC774 \uB9CC\uBB3C\uC744 \uBA38\uAE08\uB4EF \uC785\uC220\uC740
    \uC18C\uB9AC\uB97C \uBA38\uAE08\uB294\uB2E4."
  Lore: "\u3141\xB7\u3142\xB7\u314D\uC758 \uC9C4\uC774 \uD759\uACFC \uBC14\uC704\uB85C
    \uB9FA\uD788\uB294 \uC774\uCE58\uAC00 \uC5EC\uAE30 \uC788\uB2E4."
